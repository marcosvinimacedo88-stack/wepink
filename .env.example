# ===== Banco de dados (SQL Server) =====
DB_SERVIDOR=
DB_PORTA=1433
DB_USUARIO=
DB_SENHA=
DB_BANCO=manager
# 1 = conexão criptografada (TLS). Deixe 0 se o SQL Server não tiver certificado.
DB_CRIPTOGRAFAR=0

# ===== Portal =====
PORTA=3000
# Texto usado no filtro: WHERE Remetente LIKE '%...%'
FILTRO_REMETENTE=SAVI COSMETICOS LTDA
# Usuários de acesso ao portal, formato usuario:senha separados por ;
PORTAL_USUARIOS=admin:troque-esta-senha
# Segredo que assina o login (não compartilhe)
SESSAO_SEGREDO=
SESSAO_HORAS=12
LIMITE_EXPORTACAO=200000
# 1 quando o portal estiver atrás de HTTPS
HTTPS=0

# ===== Rastreamento (API dos Correios) =====
# Mesmas credenciais usadas no script de rastreio do SQL Server
CORREIOS_URL=https://api.correios.com.br
CORREIOS_USUARIO=
CORREIOS_CHAVE=
# Tabela onde o status é gravado (criar com criar_tabela_rastreamento.sql)
TABELA_RASTREIO=PORTAL_RASTREAMENTO
# Reaproveita a última consulta salva por até N minutos (objetos entregues nunca são consultados de novo sem pedir)
RASTREIO_CACHE_MIN=30
# Limite de consultas aos Correios por usuário por minuto
RASTREIO_POR_MINUTO=90
# T = histórico completo, U = só o último evento (se o contrato recusar T, o portal muda para U sozinho)
CORREIOS_RESULTADO=T

# ===== WhatsApp automático =====
# meta = API oficial (Cloud API da Meta) | zapi = Z-API | vazio = desligado (só avisos no sino)
WHATSAPP_PROVEDOR=
# Endereço do portal, vai no fim das mensagens (ex.: https://wepink-xi.vercel.app)
PORTAL_URL=
# --- Meta (oficial) ---
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
WHATSAPP_META_VERSAO=v25.0
WHATSAPP_META_IDIOMA=pt_BR
WHATSAPP_META_MODELO_TEXTO=agf_aviso
WHATSAPP_META_MODELO_IMAGEM=agf_protocolo
# --- Z-API ---
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Locais de coleta (separados por ;)
LOCAIS_COLETA=Galpão;SLV;SAVI CD

# ===== Ponte MySQL (dados do MySQL local) =====
# Endereço do túnel da Cloudflare e o mesmo token do .env da ponte
PONTE_URL=
PONTE_TOKEN=
